# Stage 1: Build a 100% static Go binary (zero dynamic library dependencies)
FROM golang:1.22-alpine AS builder

WORKDIR /build
COPY main.go .
RUN go mod init proof-gateway && \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /vericred-gateway main.go

# Stage 2: Official Midnight Proof Server image
FROM midnightntwrk/proof-server:8.1.0

COPY --from=builder /vericred-gateway /usr/local/bin/vericred-gateway

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/vericred-gateway"]