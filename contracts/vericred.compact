pragma language_version >= 0.14;

import CompactStandardLibrary;

// =============================================================================
//  VeriCred — Privacy-Preserving Credential Verification Network
//
//  Privacy invariant:
//    No witness-derived value reaches the public ledger without an explicit
//    disclose() call. The Compact compiler enforces this at compile time.
//
//  Roles:
//    - Governance: registers issuers (medical boards, hospitals, training bodies)
//    - Issuer:     issues credentials bound to a holder commitment
//    - Holder:     stores credentials privately, generates ZK proofs
//    - Verifier:   receives a boolean proof result, learns nothing else
// =============================================================================


// -----------------------------------------------------------------------------
//  Public ledger state
// -----------------------------------------------------------------------------

export ledger governancePub: Bytes<32>;
export ledger domainSeparator: Bytes<32>;
export ledger issuers: Set<Bytes<32>>;
export ledger issuedBy: Map<Bytes<32>, Bytes<32>>;
export ledger revoked: Set<Bytes<32>>;
export ledger verificationCount: Counter;


// -----------------------------------------------------------------------------
//  Types
// -----------------------------------------------------------------------------

export enum CredentialType {
  RN,
  MD,
  LPN,
  EMT,
  CUSTOM
}

/**
 * A credential as it exists in the holder's PRIVATE STATE.
 *
 * None of these fields are ever written to the public ledger.
 * The only thing that touches the chain is `credentialCommitmentOf(...)`.
 */
export struct Credential {
  licenseNumber: Bytes<32>,
  issuingBoard: Bytes<32>,
  issueDate: Uint<64>,
  expiryDate: Uint<64>,
  credentialType: CredentialType,
  holderCommitment: Bytes<32>,
  issuerPub: Bytes<32>
}


// -----------------------------------------------------------------------------
//  Witnesses — the private-state interface
// -----------------------------------------------------------------------------

witness getCredential(): Credential;
witness getUserSecretKey(): Bytes<32>;
witness getIssuerSecretKey(): Bytes<32>;
witness getGovernanceSecret(): Bytes<32>;


// -----------------------------------------------------------------------------
//  Internal helpers (not exported — not callable from outside the contract)
// -----------------------------------------------------------------------------

circuit holderCommitmentOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

circuit issuerPubOf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Bytes<32>>(secret);
}

/**
 * The credential commitment is the ONLY value derived from credential data
 * that is ever disclosed. It is a one-way hash: given the commitment alone,
 * an observer cannot recover the license number, expiry, or issuing board.
 *
 * [API] persistentHash over a struct — requires Credential to be a persistent
 * type in your Compact version (it is, as of 0.14).
 */
circuit credentialCommitmentOf(c: Credential): Bytes<32> {
  return persistentHash<Credential>(c);
}


// -----------------------------------------------------------------------------
//  Constructor
// -----------------------------------------------------------------------------

constructor() {
  governancePub = disclose(issuerPubOf(getGovernanceSecret()));

  domainSeparator = disclose(
    persistentHash<Bytes<32>>(
      0x00000000000000000000000056657269437265642f76312f6d69646e69676874 as Bytes<32>
    )
  );
}

export circuit registerIssuer(issuerPub: Bytes<32>): [] {
  const govSecret = getGovernanceSecret();
  assert(issuerPubOf(govSecret) == governancePub, "Not governance");
  
  const ip = disclose(issuerPub);
  assert(!issuers.member(ip), "Issuer already registered");
  issuers.insert(ip);
}

export circuit deregisterIssuer(issuerPub: Bytes<32>): [] {
  const govSecret = getGovernanceSecret();
  assert(issuerPubOf(govSecret) == governancePub, "Not governance");
  
  const ip = disclose(issuerPub);
  assert(issuers.member(ip), "Issuer not registered");
  issuers.remove(ip);
}

// -----------------------------------------------------------------------------
//  Circuit 1 — issueCredential
//
//  What it proves:
//    An authorized issuer created a credential bound to a specific holder
//    commitment.
//
//  What becomes public:
//    - The credential commitment (pseudonymous)
//    - The issuer's public key
//
//  What stays private:
//    - The holder's identity
//    - The license number, issuing board, issue date, expiry date
// -----------------------------------------------------------------------------

export circuit issueCredential(
  holderCommitment: Bytes<32>,
  credentialType: CredentialType,
  licenseNumber: Bytes<32>,
  issuingBoard: Bytes<32>,
  issueDate: Uint<64>,
  expiryDate: Uint<64>
): Bytes<32> {
  const issuerSecret = getIssuerSecretKey();
  const issuerPub = issuerPubOf(issuerSecret);
  const ip = disclose(issuerPub); // Disclose immediately
  assert(issuers.member(ip), "Issuer not registered");
  assert(expiryDate > issueDate, "Expiry must be after issue date");

  const credential = Credential {
    licenseNumber: licenseNumber,
    issuingBoard: issuingBoard,
    issueDate: issueDate,
    expiryDate: expiryDate,
    credentialType: credentialType,
    holderCommitment: holderCommitment,
    issuerPub: issuerPub
  };

  const commitment = credentialCommitmentOf(credential);
  const c = disclose(commitment);
  issuedBy.insert(c, ip);

  return c;
}


// -----------------------------------------------------------------------------
//  Circuit 2 — proveCredential  (the core privacy circuit)
//
//  What it proves:
//    The holder possesses a valid, non-revoked credential issued by a
//    registered authority, of the required type, and not yet expired.
//
//  What becomes public:
//    - A boolean true (the proof succeeded) OR a revert (the proof failed)
//    - A nullifier (replay protection, scoped to this requirement)
//    - The credential commitment (see "Known limitation" in docs/privacy-model.md)
//
//  What stays private:
//    - License number, issuing board, issue date, expiry date, holder identity
// -----------------------------------------------------------------------------

export circuit proveCredential(
  requirementId: Bytes<32>,
  requiredType: CredentialType,
  currentEpoch: Uint<64>
): Boolean {
  const credential = getCredential();
  const userSecret = getUserSecretKey();

  assert(
    credential.holderCommitment == holderCommitmentOf(userSecret),
    "Credential does not belong to this holder"
  );

  const ip = disclose(credential.issuerPub);
  assert(issuers.member(ip), "Unknown issuer");
  assert(credential.expiryDate > currentEpoch, "Credential expired");
  assert(credential.credentialType == requiredType, "Wrong credential type");
  const commitment = credentialCommitmentOf(credential);
  const c = disclose(commitment);

  assert(issuedBy.member(c), "Credential was never issued");
  const owner = issuedBy.lookup(c);
  assert(owner == ip, "Issuer mismatch");

  assert(!revoked.member(c), "Credential revoked");

  // --- Nullifier — prevents replay of the same proof ---------------------
  //     Scoped to (commitment, requirement, domain). Two different verifiers
  //     asking for two different requirements see two unlinkable nullifiers.
  const nullifier = persistentHash<Vector<3, Bytes<32>>>([
    c,
    requirementId,
    domainSeparator
  ]);
  disclose(nullifier);

  // --- Emit the result ---------------------------------------------------
  //     We disclose `true` because a false result reverts above. A verifier
  //     seeing a mined transaction knows the circuit reached this point.
  verificationCount.increment(1);
  return disclose(true);
}


// -----------------------------------------------------------------------------
//  Circuit 3 — revokeCredential
//
//  What it proves:
//    The original issuing authority revoked a credential it previously issued.
//
//  What becomes public:
//    - The revoked commitment
//
//  What stays private:
//    - The link between that commitment and any specific holder
// -----------------------------------------------------------------------------

export circuit revokeCredential(credentialCommitment: Bytes<32>): [] {
  const issuerSecret = getIssuerSecretKey();
  
  const ip = disclose(issuerPubOf(issuerSecret));
  const c = disclose(credentialCommitment);

  assert(issuers.member(ip), "Issuer not registered");
  assert(!revoked.member(c), "Already revoked");

  assert(issuedBy.member(c), "Credential not found");
  const owner = issuedBy.lookup(c);
  assert(owner == ip, "Only the issuing authority can revoke");

  revoked.insert(c);
}